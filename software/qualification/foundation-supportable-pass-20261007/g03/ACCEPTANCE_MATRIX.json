      "checks": [
        "unknownCannotBecomeNegative",
        "duplicateCanonicalSourceNameIsRejectedBeforeEvaluation"
      ]
    },
    {
      "id": "G03-03",
      "case": "MET sulfur lookalikes",
      "expected": "Known thiol/thiolate/disulfide/sulfoxide/sulfonium or extra neighbor UNSUPPORTED",
