    {
      "id": "G03-10",
      "case": "same geometry in different state / changed bytes",
      "expected": "Exact binding rejection",
      "checks": [
        "changedStateCannotConsumePriorEvidence",
        "sameIdentityChangedBytesRejected",
        "changedRawGeometryCannotReplay",
        "exactOrderedAnchorTupleCannotBeReplaced",
        "identicalCoordinatesInAnotherStateCannotReplay"
