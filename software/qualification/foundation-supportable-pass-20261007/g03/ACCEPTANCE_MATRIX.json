        "boundedExclusionsAreNotContactAbsence"
      ]
    },
    {
      "id": "G03-05",
      "case": "missing H/charge/NONE/aromaticity/source connection",
      "expected": "UNKNOWN; no scientific positive or negative",
      "checks": [
