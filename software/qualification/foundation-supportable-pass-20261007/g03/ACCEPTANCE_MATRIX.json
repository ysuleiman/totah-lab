        "boundedExclusionsAreNotContactAbsence"
      ]
    },
    {
      "id": "G03-04",
      "case": "PHE substituted/hetero/fused ring; plain and flagged Kekule source order",
      "expected": "UNSUPPORTED; no aromatic domain extension",
