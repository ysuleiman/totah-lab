        "boundedExclusionsAreNotContactAbsence",
        "diagnosticOrRepresentationVariationDoesNotAddCriterion"
      ]
    },
    {
      "id": "G03-08",
      "case": "degenerate/nonfinite/unqualified geometry",
      "expected": "UNKNOWN for degenerate/unqualified geometry; nonfinite coordinates rejected by unchanged Point3D source boundary before evaluation.",
      "checks": [
        "unknownCannotBecomeNegative",
        "diagnosticOrRepresentationVariationDoesNotAddCriterion",
