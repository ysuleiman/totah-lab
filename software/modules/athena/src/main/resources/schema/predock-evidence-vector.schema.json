{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://totah.lab/schema/predock-evidence-vector-v1.json",
  "title": "Dimension-preserving pre-docking evidence vector",
  "type": "object",
  "required": ["candidateId", "conformerId", "grammarId", "hardRules", "positiveRecognition", "distanceEnvelopes", "counterRecognitionFeaturesMatched", "scaffoldConstraints", "templateCompatibility", "chemicalState", "physicochemical", "liability", "synthesis", "exploration", "hardRulesPass"],
  "properties": {
    "candidateId": {"type": "string"}, "conformerId": {"type": "string"}, "grammarId": {"type": "string"},
    "hardRules": {"type": "array"}, "positiveRecognition": {"type": "array"}, "distanceEnvelopes": {"type": "array"},
    "angleConstraints": {"type": "array"}, "alternativeFeaturesUsed": {"type": "array"},
    "counterRecognitionFeaturesMatched": {"type": "array"}, "scaffoldConstraints": {"type": "array"},
    "templateCompatibility": {"type": "array"}, "chemicalState": {"type": "object"},
    "physicochemical": {"type": "object"}, "liability": {"type": "object"}, "synthesis": {"type": "object"},
    "exploration": {"type": "object"}, "hardRulesPass": {"type": "boolean"}, "provenance": {"type": "array"}
  },
  "additionalProperties": false
