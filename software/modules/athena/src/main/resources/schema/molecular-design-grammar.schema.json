{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://totah.lab/schema/molecular-design-grammar-v1.json",
  "title": "Target-independent molecular design grammar",
  "type": "object",
  "required": ["id", "version", "positiveFeatureGroups", "counterRecognitionGroups", "hardConstraints", "softObjectives", "chemicalStatePolicy", "physicochemicalPolicy", "explorationPolicy"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "positiveFeatureGroups": {"type": "array", "items": {"$ref": "#/$defs/featureGroup"}},
    "counterRecognitionGroups": {"type": "array", "items": {"$ref": "#/$defs/featureGroup"}},
    "scaffoldInvariants": {"type": "array"},
    "editableVectors": {"type": "array"},
    "distanceEnvelopes": {"type": "array"},
    "angleConstraints": {"type": "array"},
    "hardConstraints": {"type": "array"},
    "softObjectives": {"type": "array"},
    "chemicalStatePolicy": {"type": "object"},
    "physicochemicalPolicy": {"type": "object"},
    "explorationPolicy": {"type": "object"},
    "templateIds": {"type": "array", "items": {"type": "string"}},
    "provenance": {"type": "object", "additionalProperties": {"type": "string"}}
  },
  "$defs": {
    "featureGroup": {
      "type": "object",
      "required": ["id", "requirement", "minimumSatisfied", "features"],
      "properties": {
        "id": {"type": "string"},
        "requirement": {"enum": ["REQUIRED", "OPTIONAL", "ALTERNATIVE"]},
        "minimumSatisfied": {"type": "integer", "minimum": 0},
        "features": {"type": "array"},
        "alternativeGroupIds": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
