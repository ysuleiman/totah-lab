{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "athena-rule/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ruleId",
    "version",
    "profile",
    "tier",
    "implementationId",
    "implementationVersion",
    "schema",
    "family",
    "qualification",
    "retired",
    "requiredCapabilities",
    "requiredChemistry",
    "requiredGeometry",
    "measurementsProduced",
    "classificationStates",
    "parameters",
    "scientificSources",
    "referenceArtifacts",
    "limitations"
  ],
  "properties": {
    "ruleId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "type": "string",
      "minLength": 1
    },
    "implementationId": {
      "type": "string",
      "minLength": 1
    },
    "implementationVersion": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "const": "athena-rule/1"
    },
    "family": {
      "enum": [
        "VALIDATOR",
        "INTERACTION",
        "MOTIF",
        "ENVIRONMENT"
      ]
    },
    "qualification": {
      "enum": [
        "QUALIFIED",
        "CONDITIONAL",
        "NOT_EVALUATED",
        "UNSUPPORTED",
        "FAILED"
      ]
    },
    "retired": {
      "type": "boolean"
    },
    "requiredCapabilities": {
      "type": "array",
      "items": {
        "enum": [
          "DISTANCE_QUERIES",
          "NEIGHBORHOOD_TRAVERSAL",
          "GRAPH_TRANSFORMATIONS",
          "CLASH_ANALYSIS",
          "INTERACTION_TYPING",
          "HBOND_ANALYSIS",
          "ENERGETICS"
        ]
      }
    },
    "requiredChemistry": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requiredGeometry": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "measurementsProduced": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "classificationStates": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "enum": [
          "SUPPORTED_PRESENT",
          "ABSENT_FALSE",
          "NOT_EVALUATED",
          "UNSUPPORTED",
          "UNKNOWN_INCONCLUSIVE",
          "FAILED"
        ]
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "unit",
          "definition"
        ],
        "properties": {
          "value": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "enum": [
              "angstrom",
              "degree",
              "dimensionless",
              "policy"
            ]
          },
          "definition": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scientificSources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "locator",
          "sha256",
          "citation"
        ],
        "properties": {
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "citation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "referenceArtifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "locator",
          "sha256",
          "citation"
        ],
        "properties": {
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "citation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
