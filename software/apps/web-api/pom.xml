<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>totah.lab</groupId>
        <artifactId>totah-lab-apps</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>web-api</artifactId>
    <name>Totah Lab Web API</name>
    <description>Web-facing gateway for Totah Lab docking workflows</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
        </dependency>

        <dependency>
            <groupId>totah.lab</groupId>
            <artifactId>gaia</artifactId>
        </dependency>
        <dependency>
            <groupId>totah.lab</groupId>
            <artifactId>athena</artifactId>
        </dependency>

        <dependency>
            <groupId>totah.lab</groupId>
            <artifactId>hermes</artifactId>
        </dependency>

        <dependency>
            <groupId>totah.lab</groupId>
            <artifactId>daedalus</artifactId>
        </dependency>

        <dependency>
            <groupId>totah.lab</groupId>
            <artifactId>euclid</artifactId>
        </dependency>

        <dependency>
            <groupId>totah.lab</groupId>
            <artifactId>lab-report</artifactId>
        </dependency>

        <dependency>
            <groupId>totah.lab</groupId>
            <artifactId>proteus</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
            <testResource>
                <directory>../../../tools/scripts/sql/docking</directory>
                <includes>
                    <include>experimental-assembly.sql</include>
                    <include>component-pocket-annotation.sql</include>
                </includes>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
